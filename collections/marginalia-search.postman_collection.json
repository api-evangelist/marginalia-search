      "name": "Search",
      "description": {
        "content": "Search the Marginalia index.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3093fd40-3f1e-43d7-a23b-442163afc149",
          "name": "Execute a web search",
          "request": {
            "name": "Execute a web search",
            "description": {
              "content": "Run a search query against the Marginalia index and return ranked results. Optional parameters allow paging, per-domain capping, NSFW filtering, and named filter application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Search terms."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "Number of results to return."
                },
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "<integer>",
                  "description": "Maximum execution time in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "dc",
                  "value": "<integer>",
                  "description": "Maximum results per domain."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Result page (1-indexed)."
                },
                {
                  "disabled": false,
                  "key": "nsfw",
                  "value": "<integer>",
                  "description": "NSFW content filtering (experimental)."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Apply a named filter previously created via /filter."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
