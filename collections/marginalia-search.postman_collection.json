    "_postman_id": "37db348b-3ebb-46ec-ac33-a71d07ba71d7",
    "name": "Marginalia Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Marginalia Search API provides programmatic access to the Marginalia independent search engine, focused on non-commercial content. The new API is hosted at api2.marginalia-search.com; legacy endpoints at api.marginalia.nu and api.marginalia-search.com remain available but deprecated. Search results are available under CC-BY-NC-SA 4.0 for non-commercial use.\n\nContact Support:\n Name: Marginalia Search\n Email: contact@marginalia-search.com",
      "type": "text/plain"
    }
  }
